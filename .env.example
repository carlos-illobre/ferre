# Copiar a .env y completar. Todas las variables son obligatorias: si falta una, el
# contenedor no arranca. La misma lista tiene que estar en deployment/oracle-single/.env.oracle;
# tests/integration/paridad_env.sh lo verifica.

# Dominio que sirve Caddy. "http://localhost" en desarrollo (sin TLS); el dominio real en producción.
SITIO=http://localhost

# Origen del cliente web, único permitido por CORS. En desarrollo, el `vite preview` local;
# en producción, la URL de GitHub Pages o el dominio propio del cliente (ADR-010).
ORIGEN_WEB=http://localhost:4173

# ID de cliente OAuth de Google para el login (docs/google-cloud.md). En desarrollo puede
# quedar el marcador: el login con Google no funciona, pero el resto sí.
GOOGLE_CLIENT_ID=sin-configurar.apps.googleusercontent.com

# Cadena de conexión PostgreSQL. En desarrollo apunta al servicio `db` del compose
# (perfil local); en producción, a Supabase (ADR-002).
DATABASE_URL=postgres://ferre:ferre@db:5432/ferre

# Token compartido entre servicios para las llamadas internas (ADR-003). Generar uno largo y aleatorio.
TOKEN_SERVICIO=cambiar-por-un-token-largo-y-aleatorio

# Registro de imágenes y etiqueta a desplegar. En desarrollo, `docker compose build` construye
# localmente con este mismo nombre; en producción se descargan las publicadas por CI (ADR-007).
REGISTRO=ghcr.io/carlos-illobre/ferre
IMAGEN_TAG=local
