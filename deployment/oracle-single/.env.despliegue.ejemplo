# Configuración de DESPLIEGUE (no de la aplicación): solo lo necesario para llegar a la
# máquina desde tu computadora. Copiar a deployment/oracle-single/.env. Está en el .gitignore.
# En CI estos mismos valores salen de los secretos ORACLE_USUARIO, ORACLE_HOST y ORACLE_SSH_KEY.
SSH=ubuntu@<ip-publica>
# Carpeta base en la máquina; adentro viven produccion/ y pruebas/.
RUTA_REMOTA=ferre
