# Plantilla del .env de producción en la máquina de Oracle. Copiar a
# deployment/oracle-single/.env y reemplazar los marcadores. Nunca versionar el .env real.

# Dominio real. Caddy emite el certificado solo si el puerto 80 y el DNS ya están listos.
SITIO=<dominio.ejemplo.com>

# Origen del cliente web publicado en GitHub Pages (sin barra final).
ORIGEN_WEB=<https://carlos-illobre.github.io>

# ID de cliente OAuth de Google (docs/google-cloud.md, paso 3).
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com

# Cadena de conexión de Supabase (Settings → Database → Connection string, modo session).
DATABASE_URL=<postgres://usuario:clave@host.supabase.co:5432/postgres>

# Token largo y aleatorio: `openssl rand -hex 32`
TOKEN_SERVICIO=<token>

# Imágenes publicadas por CI. IMAGEN_TAG es el SHA corto del commit desplegado.
REGISTRO=ghcr.io/carlos-illobre/ferre
IMAGEN_TAG=<sha>
