# systemd de USUARIO (~/.config/systemd/user/): escucha los avisos de despliegue de ferre.
# Sin root: corre como el usuario sin privilegios dueño del Docker rootless. instalar.sh
# completa DOCKER_HOST y las rutas con los del usuario que lo corre.
[Unit]
Description=ferre: escucha los avisos de despliegue (ntfy) y despliega verificando contra GitHub
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
Environment=DOCKER_HOST=unix://__XDG_RUNTIME_DIR__/docker.sock
Environment=PATH=__HOME__/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__HOME__/ferre/bin/escuchar.sh
Restart=always
RestartSec=10
NoNewPrivileges=true
# Sin PrivateTmp: en un servicio de usuario systemd lo implementa con un user namespace
# sin privilegios, y el perfil AppArmor de Ubuntu 24.04 le niega el socket de Docker
# rootless ("DENIED ... docker.sock" en el journal del kernel).

[Install]
WantedBy=default.target
