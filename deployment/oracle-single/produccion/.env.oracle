# Plantilla del .env de la aplicación en PRODUCCIÓN, en la máquina de Oracle
# (~/ferre/produccion/.env). Copiar y reemplazar los marcadores. Nunca versionar el .env real.

COMPOSE_PROJECT_NAME=ferre-produccion
# Solo Caddy: la base es Supabase. Este Caddy atiende también el dominio de pruebas.
COMPOSE_PROFILES=borde
AMBIENTE=produccion

# Dominio de la API de producción. Caddy emite el certificado solo si el puerto 80 y el DNS ya están listos.
SITIO=<api.dominio.ejemplo.com>
# Dominio de la API de pruebas (lo sirve este mismo Caddy).
SITIO_PRUEBAS=<api-pruebas.dominio.ejemplo.com>

# Origen del cliente web en GitHub Pages (sin barra final). Producción y pruebas comparten origen.
ORIGEN_WEB=https://carlos-illobre.github.io

# ID de cliente OAuth de Google (docs/google-cloud.md, paso 3).
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com

# Cadena de conexión del proyecto de Supabase de PRODUCCIÓN (Settings → Database → Connection string, modo session).
DATABASE_URL=<postgres://usuario:clave@host.supabase.co:5432/postgres>

# Token largo y aleatorio, distinto del de pruebas: `openssl rand -hex 32`
TOKEN_SERVICIO=<token>

# Imágenes publicadas por CI. IMAGEN_TAG la escribe el despliegue con el SHA del commit.
REGISTRO=ghcr.io/carlos-illobre/ferre
IMAGEN_TAG=<sha>
