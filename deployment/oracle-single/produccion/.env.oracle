# Plantilla del .env de la aplicación en PRODUCCIÓN, en la máquina de Oracle
# (~/ferre/produccion/.env). Copiar y reemplazar los marcadores. Nunca versionar el .env real.

# El ambiente (desarrollo, pruebas o produccion). En la máquina no lo lee ninguna pieza: la web de
# este ambiente se construye en la CI, que le pasa el mismo valor (docs/operacion/DEPLOYMENT.md).
# Se deja para que los .env de todos los ambientes tengan las mismas claves.
AMBIENTE=produccion

COMPOSE_PROJECT_NAME=ferre-produccion
# Sin perfiles: el proxy es el de la máquina.
COMPOSE_PROFILES=

# Puerto local donde el reverse proxy de la máquina encuentra la API de producción.
PUERTO_API=8081

# Dominio de la API de producción (lo sirve el reverse proxy de la máquina; acá es informativo).
SITIO=ferre-api.duckdns.org

# Origen del cliente web en GitHub Pages (sin barra final). Producción y pruebas comparten origen.
ORIGEN_WEB=https://carlos-illobre.github.io

# ID de cliente OAuth de Google (docs/operacion/google-cloud.md, paso 3).
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com

# La base (ADR-026): claves largas y aleatorias, distintas en cada ambiente: `openssl rand -hex 24`.
CLAVE_BASE_ADMIN=<clave>
CLAVE_BASE_MOSTRADOR=<clave>
CLAVE_BASE_PROCESOS=<clave>
CLAVE_BASE_AUDITORIA=<clave>
CLAVE_BASE_TICKETS=<clave>
# Puerto local de la base de este ambiente (solo 127.0.0.1).
PUERTO_BASE=5433

# Adónde mandan Comercial y Procesos lo que hizo cada uno (specs/027). Vacía, no lo mandan y
# funcionan igual; «Quién hizo qué» dice que no está disponible.
AUDITORIA_URL=http://auditoria:8095

# Token largo y aleatorio, distinto del de pruebas: `openssl rand -hex 32`
TOKEN_SERVICIO=<token>

# Imágenes publicadas por CI. IMAGEN_TAG la escribe el despliegue con el SHA del commit.
REGISTRO=ghcr.io/carlos-illobre/ferre
IMAGEN_TAG=<sha>
