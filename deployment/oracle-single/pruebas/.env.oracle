# Plantilla del .env de la aplicación en PRUEBAS, en la misma máquina de Oracle
# (~/ferre/pruebas/.env). Copiar y reemplazar los marcadores. Nunca versionar el .env real.

COMPOSE_PROJECT_NAME=ferre-pruebas
# Sin perfiles: la base es Supabase y el Caddy es el de caddy-gateway.
COMPOSE_PROFILES=
AMBIENTE=pruebas

# Dominio de la API de pruebas. El despliegue lo escribe en caddy-gateway/sitios/ferre.caddy.
SITIO=<api-pruebas.dominio.ejemplo.com>

# Origen del cliente web en GitHub Pages (sin barra final). Producción y pruebas comparten origen.
ORIGEN_WEB=https://carlos-illobre.github.io

# ID de cliente OAuth de Google (el mismo que producción: mismo origen).
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com

# Cadena de conexión del SEGUNDO proyecto de Supabase, el de pruebas: Connect → Session pooler
# (la conexión directa es solo IPv6 y la máquina sale por IPv4).
DATABASE_URL=<postgres://usuario:clave@host.supabase.co:5432/postgres>

# Token largo y aleatorio, distinto del de producción: `openssl rand -hex 32`
TOKEN_SERVICIO=<token>

REGISTRO=ghcr.io/carlos-illobre/ferre
IMAGEN_TAG=<sha>
