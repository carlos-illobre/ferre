{
  "name": "procesos-servidor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { "./contrato": "./src/contrato.ts" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.pruebas.json && pnpm capas",
    "capas": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "bpmn-moddle": "10.3.1",
    "hono": "^4.6.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "dependency-cruiser": "18.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
