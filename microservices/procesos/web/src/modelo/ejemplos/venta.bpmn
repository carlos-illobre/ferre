<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:procesos="http://procesos.local/schema/1.0" id="Definiciones_Venta" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Colaboracion_Venta"><bpmn:participant id="Participante_Venta" name="Venta en el mostrador" processRef="Proceso_Venta" /></bpmn:collaboration>
  <bpmn:process id="Proceso_Venta" isExecutable="false">
    <bpmn:laneSet id="Carriles">
      <bpmn:lane id="Carril_Cliente" name="Cliente"><bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef><bpmn:flowNodeRef>Pide</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Carril_Vendedor" name="Vendedor"><bpmn:flowNodeRef>Buscar</bpmn:flowNodeRef><bpmn:flowNodeRef>HayStock</bpmn:flowNodeRef><bpmn:flowNodeRef>Cargar</bpmn:flowNodeRef><bpmn:flowNodeRef>Cobrar</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Carril_Sistema" name="Sistema"><bpmn:flowNodeRef>Registrar</bpmn:flowNodeRef><bpmn:flowNodeRef>Lista</bpmn:flowNodeRef><bpmn:flowNodeRef>Anotar</bpmn:flowNodeRef><bpmn:flowNodeRef>Anotado</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Llega el cliente"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Pide" name="Pide un producto"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="Buscar" name="Buscar el producto" procesos:pantalla="Vender"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="HayStock" name="¿Hay stock?" procesos:pantalla="Depósito → Inventario"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Cargar" name="Cargar en la venta" procesos:pantalla="Vender"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="Cobrar" name="Cobrar" procesos:pantalla="Vender → Cobrar"><bpmn:documentation>Efectivo viene elegido. Si paga con Mercado Pago, esperar el aviso antes de entregar.</bpmn:documentation><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Registrar" name="Registrar la venta y el stock"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Lista" name="Venta lista"><bpmn:incoming>F8</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Anotar" name="Anotar el pedido"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Anotado" name="Pedido anotado"><bpmn:incoming>F9</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Inicio" targetRef="Pide" />
    <bpmn:sequenceFlow id="F2" sourceRef="Pide" targetRef="Buscar" />
    <bpmn:sequenceFlow id="F3" sourceRef="Buscar" targetRef="HayStock" />
    <bpmn:sequenceFlow id="F4" name="Sí" sourceRef="HayStock" targetRef="Cargar" />
    <bpmn:sequenceFlow id="F5" name="No" sourceRef="HayStock" targetRef="Anotar" />
    <bpmn:sequenceFlow id="F6" sourceRef="Cargar" targetRef="Cobrar" />
    <bpmn:sequenceFlow id="F7" sourceRef="Cobrar" targetRef="Registrar" />
    <bpmn:sequenceFlow id="F8" sourceRef="Registrar" targetRef="Lista" />
    <bpmn:sequenceFlow id="F9" sourceRef="Anotar" targetRef="Anotado" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_Venta"><bpmndi:BPMNPlane id="Plano_Venta" bpmnElement="Colaboracion_Venta">
    <bpmndi:BPMNShape id="Participante_Venta_di" bpmnElement="Participante_Venta" isHorizontal="true"><dc:Bounds x="160" y="80" width="1100" height="420" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Carril_Cliente_di" bpmnElement="Carril_Cliente" isHorizontal="true"><dc:Bounds x="190" y="80" width="1070" height="140" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Carril_Vendedor_di" bpmnElement="Carril_Vendedor" isHorizontal="true"><dc:Bounds x="190" y="220" width="1070" height="140" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Carril_Sistema_di" bpmnElement="Carril_Sistema" isHorizontal="true"><dc:Bounds x="190" y="360" width="1070" height="140" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Inicio_di" bpmnElement="Inicio"><dc:Bounds x="232" y="132" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="202" y="172" width="96" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Pide_di" bpmnElement="Pide"><dc:Bounds x="300" y="110" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Buscar_di" bpmnElement="Buscar"><dc:Bounds x="460" y="250" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="HayStock_di" bpmnElement="HayStock" isMarkerVisible="true"><dc:Bounds x="625" y="265" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="615" y="243" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Cargar_di" bpmnElement="Cargar"><dc:Bounds x="730" y="250" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Cobrar_di" bpmnElement="Cobrar"><dc:Bounds x="900" y="250" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Registrar_di" bpmnElement="Registrar"><dc:Bounds x="900" y="390" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lista_di" bpmnElement="Lista"><dc:Bounds x="1082" y="412" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1052" y="452" width="96" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Anotar_di" bpmnElement="Anotar"><dc:Bounds x="600" y="390" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Anotado_di" bpmnElement="Anotado"><dc:Bounds x="772" y="412" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="742" y="452" width="96" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="268" y="150" /><di:waypoint x="300" y="150" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="420" y="150" /><di:waypoint x="520" y="150" /><di:waypoint x="520" y="250" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="580" y="290" /><di:waypoint x="625" y="290" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="675" y="290" /><di:waypoint x="730" y="290" /><bpmndi:BPMNLabel><dc:Bounds x="683" y="272" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="650" y="315" /><di:waypoint x="650" y="390" /><bpmndi:BPMNLabel><dc:Bounds x="658" y="327" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="850" y="290" /><di:waypoint x="900" y="290" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="960" y="330" /><di:waypoint x="960" y="390" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1020" y="430" /><di:waypoint x="1082" y="430" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="720" y="430" /><di:waypoint x="772" y="430" /></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
