# La puerta del servidor (specs/026, ADR-031): lo único que se publica. Reparte cada pedido al
# servicio que lo atiende según su ruta. Quién es la persona lo sabe Acceso (specs/029): a todos
# los demás servicios la puerta le pregunta antes, en cada pedido, y les pasa quién es y qué puede.
# No tiene reglas del negocio ni datos: sumar un servicio es sumar su ruta acá.
{
	admin off
	auto_https off
	servers {
		# Adelante está el reverse proxy de la máquina (o el de desarrollo): su X-Forwarded-For
		# dice quién llama, y Comercial lo usa para limitar los intentos de entrar.
		trusted_proxies static private_ranges
	}
}

:8080 {
	# Quién es la persona lo dice solo la puerta: lo que mande el navegador con estos nombres
	# se borra antes de cualquier otra cosa.
	request_header -X-Usuario-Id
	request_header -X-Usuario-Nombre
	request_header -X-Permisos
	request_header -X-Token-Servicio

	# La aplicación vive en otro origen (ADR-010): solo ese origen puede llamar desde el
	# navegador, y puede leer lo que va a cuestas en cada respuesta (X-Avisos, decisión 157).
	header Access-Control-Allow-Origin {$ORIGEN_WEB}
	header Access-Control-Expose-Headers X-Avisos
	header Vary Origin
	@consultaPrevia {
		method OPTIONS
		header Access-Control-Request-Method *
	}
	handle @consultaPrevia {
		header Access-Control-Allow-Methods "GET, HEAD, PUT, POST, DELETE, PATCH"
		header Access-Control-Allow-Headers "Authorization, Content-Type, X-Temas, X-Canal"
		respond 204
	}

	# La salud de la puerta misma, para el control del contenedor.
	handle /puerta/salud {
		respond "ok" 200
	}

	# Acceso (specs/029): entrar, las sesiones, usuarios y roles, las huellas, el vínculo, el canal de
	# cada dispositivo, lo apartado y los ajustes. Atiende con o sin sesión y la busca él mismo. El
	# canal queda abierto mientras se usa: lo que llega se manda en el momento.
	@acceso path /sesiones /sesiones/* /usuarios /usuarios/* /roles /roles/* /permisos /permisos/* /credenciales /credenciales/* /puestos /puestos/* /canal /canal/* /apartados /apartados/* /sistema /sistema/*
	handle @acceso {
		reverse_proxy acceso:8097 {
			header_up X-Token-Servicio {$TOKEN_SERVICIO}
			flush_interval -1
		}
	}

	# Procesos (ADR-019) no sabe de sesiones: la puerta pregunta quién es y qué puede.
	@procesos path /procesos /procesos/*
	handle @procesos {
		forward_auth acceso:8097 {
			uri /sesiones/quien
			header_up X-Token-Servicio {$TOKEN_SERVICIO}
			copy_headers X-Usuario-Id X-Usuario-Nombre X-Permisos
		}
		request_body {
			max_size 6MB
		}
		reverse_proxy procesos:8090 {
			header_up X-Token-Servicio {$TOKEN_SERVICIO}
		}
	}

	# Los reportes de Auditoría (specs/027), como Procesos: la puerta pregunta quién es y qué
	# puede. La entrada de eventos (/v1/eventos) no se publica: llega por la red interna.
	@auditoria path /auditoria /auditoria/*
	handle @auditoria {
		forward_auth acceso:8097 {
			uri /sesiones/quien
			header_up X-Token-Servicio {$TOKEN_SERVICIO}
			copy_headers X-Usuario-Id X-Usuario-Nombre X-Permisos
		}
		reverse_proxy auditoria:8095 {
			header_up X-Token-Servicio {$TOKEN_SERVICIO}
		}
	}

	# Tickets (specs/028), como Procesos: la puerta pregunta quién es. Hasta 5 fotos de 10 MB.
	@tickets path /tickets /tickets/*
	handle @tickets {
		forward_auth acceso:8097 {
			uri /sesiones/quien
			header_up X-Token-Servicio {$TOKEN_SERVICIO}
			copy_headers X-Usuario-Id X-Usuario-Nombre X-Permisos
		}
		request_body {
			max_size 60MB
		}
		reverse_proxy tickets:8096 {
			header_up X-Token-Servicio {$TOKEN_SERVICIO}
		}
	}

	# Un servicio que no responde (026-E08, 027-E04, 028-E06). Si es Procesos o Auditoría, se dice con palabras, como cualquier
	# otro error. Si es Comercial, Tickets o Acceso (que no puede decir quién es), se corta la
	# conexión: la aplicación lo toma como sin conexión y sigue con lo que tiene en el dispositivo.
	handle_errors 502 503 504 {
		handle @procesos {
			header Access-Control-Allow-Origin {$ORIGEN_WEB}
			header Access-Control-Expose-Headers X-Avisos
			header Content-Type application/json
			respond `{"error":"Procesos no responde ahora. Probá de nuevo en un rato"}` {err.status_code}
		}
		handle @auditoria {
			header Access-Control-Allow-Origin {$ORIGEN_WEB}
			header Access-Control-Expose-Headers X-Avisos
			header Content-Type application/json
			respond `{"error":"Quién hizo qué no está disponible ahora. Probá de nuevo en un rato"}` {err.status_code}
		}
		# Comercial, Tickets o Acceso: se corta la conexión y la aplicación lo toma como sin conexión
		# (un ticket queda guardado en el dispositivo para mandarlo después).
		handle {
			abort
		}
	}

	# Lo que Comercial atiende sin sesión: su salud (la mira el monitor y la aplicación, para saber
	# si hay conexión) y las fotos de los productos (las pide el navegador, sin el token).
	@comercialSinSesion path /health /fotos/*
	handle @comercialSinSesion {
		reverse_proxy comercial:8080 {
			header_up X-Token-Servicio {$TOKEN_SERVICIO}
		}
	}

	# Lo demás es de Comercial: la puerta pregunta quién es y qué puede, como a los otros.
	handle {
		forward_auth acceso:8097 {
			uri /sesiones/quien
			header_up X-Token-Servicio {$TOKEN_SERVICIO}
			copy_headers X-Usuario-Id X-Usuario-Nombre X-Permisos
		}
		reverse_proxy comercial:8080 {
			header_up X-Token-Servicio {$TOKEN_SERVICIO}
		}
	}
}
